-- =========================================
-- PLANEJAR ETAPA
-- =========================================

CREATE TABLE etapa (
    id SERIAL PRIMARY KEY,
    id_agendamento INTEGER NOT NULL,
    descricao TEXT NOT NULL,
    data_hora_inicio TIMESTAMP NOT NULL,

    FOREIGN KEY (id_agendamento)
	REFERENCES agendamento_atividade(id)
    ON DELETE CASCADE
);

CREATE TABLE agendamento_material (
    id SERIAL PRIMARY KEY,

    id_agendamento INTEGER NOT NULL,
    id_item INTEGER NOT NULL,
    quantidade INTEGER NOT NULL,

    CONSTRAINT fk_agendamento_material_agendamento
        FOREIGN KEY (id_agendamento)
        REFERENCES agendamento_atividade(id),

    CONSTRAINT fk_agendamento_material_item
        FOREIGN KEY (id_item)
        REFERENCES estoque(id),

    CONSTRAINT uq_agendamento_item
        UNIQUE (id_agendamento, id_item)
);

-- =========================================
-- FAMILIAR
-- =========================================

CREATE TABLE familiar (
    id_familiar SERIAL PRIMARY KEY,

    id_beneficiario INTEGER NOT NULL,

    nome VARCHAR(100) NOT NULL,
    parentesco VARCHAR(50) NOT NULL,
    profissao VARCHAR(100),

    renda NUMERIC(10,2) DEFAULT 0,

    telefone VARCHAR(15) NOT NULL,

    CONSTRAINT fk_familiar_beneficiario
        FOREIGN KEY (id_beneficiario)
        REFERENCES beneficiario(id)
        ON DELETE CASCADE
);

-- =========================================
-- USUARIO
-- =========================================

CREATE TABLE usuario (
    id_usuario SERIAL PRIMARY KEY,
    login VARCHAR(50) NOT NULL UNIQUE,
    senha VARCHAR(255) NOT NULL,
    ativo BOOLEAN DEFAULT TRUE,
    id_funcionario INTEGER NOT NULL UNIQUE,

    FOREIGN KEY (id_funcionario)
        REFERENCES funcionario(id_funcionario)
);


CREATE TABLE categoria (
    id_categoria SERIAL,
    nome VARCHAR(100) NOT NULL,

    CONSTRAINT pk_categoria PRIMARY KEY (id_categoria),
    CONSTRAINT un_categoria_nome UNIQUE (nome)
);

CREATE TABLE atividade (
    id_atividade SERIAL,
    descricao VARCHAR(255) NOT NULL,
    id_categoria INTEGER NOT NULL,
    id_funcionario INTEGER NOT NULL,

    CONSTRAINT pk_atividade PRIMARY KEY (id_atividade),

    CONSTRAINT fk_atividade_categoria
        FOREIGN KEY (id_categoria)
        REFERENCES categoria(id_categoria),

    CONSTRAINT fk_atividade_funcionario
        FOREIGN KEY (id_funcionario)
        REFERENCES funcionario(id_funcionario)
);

CREATE TABLE AgendamentoAtividade (
    id SERIAL PRIMARY KEY,
    atividade_id INT NOT NULL,
    dataInicio TIMESTAMP NOT NULL,
    dataFim TIMESTAMP,
    observacao TEXT,
    CONSTRAINT fk_atividade
        FOREIGN KEY (atividade_id)
        REFERENCES Atividade(id_atividade)
        ON DELETE CASCADE
);
CREATE TABLE funcionario (
    id_funcionario SERIAL,
    nome VARCHAR(100) NOT NULL,
    cpf CHAR(11) NOT NULL,
    telefone VARCHAR(15),
    nis CHAR(11) NOT NULL,
    nascimento DATE NOT NULL,
    sexo CHAR(1) NOT NULL,
    endereco VARCHAR(200),
    cargo VARCHAR(50),

    CONSTRAINT pk_funcionario PRIMARY KEY (id_funcionario),
    CONSTRAINT un_cpf UNIQUE (cpf),
    CONSTRAINT un_nis UNIQUE (nis),

    CONSTRAINT chk_sexo CHECK (sexo IN ('M', 'F', 'O')),
    CONSTRAINT chk_cpf_format CHECK (cpf ~ '^[0-9]{11}$'),
    CONSTRAINT chk_nis_format CHECK (nis ~ '^[0-9]{11}$'),
    CONSTRAINT chk_telefone_format CHECK (telefone IS NULL OR telefone ~ '^[0-9]+$')
);

CREATE TABLE beneficiario (
    id SERIAL,

    nome VARCHAR(100) NOT NULL,
    nascimento DATE NOT NULL,
    idade INTEGER,

    rg VARCHAR(20),
    cpf CHAR(11) NOT NULL,
    nis CHAR(11),

    renda NUMERIC(10,2),

    endereco VARCHAR(200),
    bairro VARCHAR(100),
    tipo_residencia VARCHAR(50),

    telefone VARCHAR(15),
    celular VARCHAR(15),
    celular_recado VARCHAR(15),

    alergias VARCHAR(255),
    tratamentos VARCHAR(255),

    participacao VARCHAR(100),
    situacao VARCHAR(50),

    CONSTRAINT pk_beneficiario PRIMARY KEY (id),

    CONSTRAINT un_beneficiario_cpf UNIQUE (cpf),
    CONSTRAINT un_beneficiario_nis UNIQUE (nis),

    CONSTRAINT chk_beneficiario_cpf_format CHECK (cpf ~ '^[0-9]{11}$'),
    CONSTRAINT chk_beneficiario_nis_format CHECK (nis IS NULL OR nis ~ '^[0-9]{11}$'),

    CONSTRAINT chk_beneficiario_telefone CHECK (telefone IS NULL OR telefone ~ '^[0-9]+$'),
    CONSTRAINT chk_beneficiario_celular CHECK (celular IS NULL OR celular ~ '^[0-9]+$'),
    CONSTRAINT chk_beneficiario_celular_recado CHECK (celular_recado IS NULL OR celular_recado ~ '^[0-9]+$')
);

CREATE TABLE remedio(
    id SERIAL,
    nome VARCHAR(45),
    descricao VARCHAR(100),

    CONSTRAINT pk_remedio PRIMARY KEY (id)
);

CREATE TABLE prescricao(
    id SERIAL,
    dosagem VARCHAR(45),
    quantidade INT,
    horario DATE,
    idBeneficiario INT,
    idRemedio INT,
    intervalo INT,

    CONSTRAINT pk_prescricao PRIMARY KEY (id),

    CONSTRAINT fk_prescricao_beneficiario
        FOREIGN KEY (idBeneficiario)
        REFERENCES beneficiario(id),

    CONSTRAINT fk_prescricao_remedio
        FOREIGN KEY (idRemedio)
        REFERENCES remedio(id)
);


CREATE TABLE vincularbeneficiario (
    idAgendamento INT NOT NULL,
    idBeneficiario INT NOT NULL,

    CONSTRAINT pk_vb_agendamento PRIMARY KEY (idAgendamento, idBeneficiario),

    CONSTRAINT fk_vb_agendamento
        FOREIGN KEY (idAgendamento)
        REFERENCES AgendamentoAtividade(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_vb_beneficiario
        FOREIGN KEY (idBeneficiario)
        REFERENCES beneficiario(id)
        ON DELETE CASCADE
);


CREATE TABLE IF NOT EXISTS ALIMENTO (
    id SERIAL,
    nome varchar(50),
    tipo varchar(50),
    descricao varchar(200),
    CONSTRAINT PK_ALIMENTO PRIMARY KEY (id)
);


CREATE TABLE IF NOT EXISTS TIPO_ESTOQUE (
    id SERIAL,
    tipo varchar(50) NOT NULL,
    CONSTRAINT PK_TIPOESTOQUE PRIMARY KEY (id),
    CONSTRAINT UN_TIPO_TIPOESTOQUE UNIQUE (tipo)
);


CREATE TABLE IF NOT EXISTS ESTOQUE (
    id SERIAL,
    descricao varchar(200),
    qtd int,
    id_tipo_estoque int,
    CONSTRAINT PK_ESTOQUE PRIMARY KEY (id),
    CONSTRAINT FK_ESTOQUE_TIPO_ESTOQUE FOREIGN KEY (id_tipo_estoque) REFERENCES TIPO_ESTOQUE(id)
);


CREATE TABLE cardapio (
    id SERIAL,
    descricao VARCHAR(255),
    data DATE NOT NULL,
    hora TIME NOT NULL,
    quantidade INTEGER,

    id_alimento INTEGER NOT NULL,
    id_agendamento INTEGER NOT NULL,

    CONSTRAINT pk_cardapio PRIMARY KEY (id),

    CONSTRAINT fk_cardapio_alimento
        FOREIGN KEY (id_alimento)
        REFERENCES alimento(id),

    CONSTRAINT fk_cardapio_agendamento
        FOREIGN KEY (id_agendamento)
        REFERENCES agendamento_atividade(id_agendamento)
);

CREATE TABLE IF NOT EXISTS EVENTO(
    id SERIAL,
    nome varchar(50) not null,
    qtd int not null,
    local varchar(200),
    id_cat_evento int not null,
    dia DATE,
    hora_inicio TIME,
    hora_fim TIME,
    id_funcionario INT,

    CONSTRAINT PK_Evento PRIMARY KEY (id),
    CONSTRAINT FK_Evento_Cat_evento FOREIGN KEY (id_cat_evento) REFERENCES CAT_EVENTO(id),
    CONSTRAINT FK_EVENTO_FUNCIONARIO FOREIGN KEY (id_funcionario) REFERENCES FUNCIONARIO(id_funcionario)
);

CREATE TABLE IF NOT EXISTS Itens_Evento(
	id_evento int,
	id_estoque int,
	qtd int not  null,
	CONSTRAINT PK_ITENS_EVENTO PRIMARY KEY (id_evento,id_estoque),
	CONSTRAINT FK_ITENS_EVENTO_Estoque FOREIGN KEY (id_estoque) REFERENCES ESTOQUE(id),
	CONSTRAINT FK_ITENS_EVENTO_Evento FOREIGN KEY (id_evento) REFERENCES Evento(id)
);










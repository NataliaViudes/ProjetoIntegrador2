-- =========================================
-- AGENDAMENTO DE ATIVIDADE
-- =========================================

DROP TABLE IF EXISTS agendamento_atividade CASCADE;

CREATE TABLE agendamento_atividade (
    id SERIAL PRIMARY KEY,

    id_atividade INTEGER NOT NULL,

    data_inicio TIMESTAMP NOT NULL,
    data_fim TIMESTAMP NOT NULL,

    observacao TEXT,

    CONSTRAINT fk_agendamento_atividade
        FOREIGN KEY (id_atividade)
        REFERENCES atividade(id_atividade)
        ON DELETE CASCADE
);


-- =========================================
-- AUXÍLIO
-- =========================================

DROP TABLE IF EXISTS auxilio CASCADE;

CREATE TABLE auxilio (
    id SERIAL,

    descricao TEXT NOT NULL,
    data DATE NOT NULL,
    status VARCHAR(10),

    id_beneficiario INTEGER NOT NULL,
    id_categoria INTEGER NOT NULL,

    CONSTRAINT pk_auxilio PRIMARY KEY (id),

    CONSTRAINT fk_auxilio_beneficiario
        FOREIGN KEY (id_beneficiario)
        REFERENCES beneficiario(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_auxilio_categoria
        FOREIGN KEY (id_categoria)
        REFERENCES categoria_auxilio(id)
);


-- =========================================
-- VINCULAR BENEFICIÁRIO
-- =========================================

DROP TABLE IF EXISTS vincularbeneficiario CASCADE;

CREATE TABLE vincularbeneficiario (
    idAgendamento INTEGER NOT NULL,
    idBeneficiario INTEGER NOT NULL,

    CONSTRAINT pk_vb_agendamento
        PRIMARY KEY (idAgendamento, idBeneficiario),

    CONSTRAINT fk_vb_agendamento
        FOREIGN KEY (idAgendamento)
        REFERENCES agendamento_atividade(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_vb_beneficiario
        FOREIGN KEY (idBeneficiario)
        REFERENCES beneficiario(id)
        ON DELETE CASCADE
);


-- =========================================
-- OCORRÊNCIA DE ATIVIDADE
-- =========================================

DROP TABLE IF EXISTS ocorrencia_atividade CASCADE;

CREATE TABLE ocorrencia_atividade (
    id SERIAL PRIMARY KEY,

    id_agendamento INTEGER NOT NULL,
    id_beneficiario INTEGER,

    tipo VARCHAR(20) NOT NULL,
    observacao TEXT NOT NULL,

    data_registro TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_ocorrencia_agendamento
        FOREIGN KEY (id_agendamento)
        REFERENCES agendamento_atividade(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_ocorrencia_beneficiario
        FOREIGN KEY (id_beneficiario)
        REFERENCES beneficiario(id)
        ON DELETE SET NULL,

    CONSTRAINT chk_tipo_ocorrencia
        CHECK (tipo IN ('GERAL', 'INDIVIDUAL')),

    CONSTRAINT chk_ocorrencia_tipo
        CHECK (
            (tipo = 'GERAL' AND id_beneficiario IS NULL)
            OR
            (tipo = 'INDIVIDUAL' AND id_beneficiario IS NOT NULL)
        )
);


CREATE TABLE atividade (
    id_atividade SERIAL,
    descricao VARCHAR(255) NOT NULL,
    id_categoria INTEGER NOT NULL,
    id_funcionario INTEGER NOT NULL,

    CONSTRAINT pk_atividade PRIMARY KEY (id_atividade),

    CONSTRAINT fk_atividade_categoria
        FOREIGN KEY (id_categoria)
        REFERENCES categoria(id_categoria),

    CONSTRAINT fk_atividade_funcionario
        FOREIGN KEY (id_funcionario)
        REFERENCES funcionario(id_funcionario)
);
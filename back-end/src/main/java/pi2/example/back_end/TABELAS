CREATE TABLE categoria (
    id_categoria SERIAL,
    nome VARCHAR(100) NOT NULL,

    CONSTRAINT pk_categoria PRIMARY KEY (id_categoria),
    CONSTRAINT un_categoria_nome UNIQUE (nome)
);

CREATE TABLE cat_evento (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL UNIQUE,
    descricao VARCHAR(255)
);

CREATE TABLE cargo (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL
);

CREATE TABLE funcionario (
    id_funcionario SERIAL,
    nome VARCHAR(100) NOT NULL,
    cpf CHAR(11) NOT NULL,
    telefone VARCHAR(15),
    nis CHAR(11) NOT NULL,
    nascimento DATE NOT NULL,
    sexo CHAR(1) NOT NULL,
    endereco VARCHAR(200),
    cargo VARCHAR(50),

    CONSTRAINT pk_funcionario PRIMARY KEY (id_funcionario),
    CONSTRAINT un_cpf UNIQUE (cpf),
    CONSTRAINT un_nis UNIQUE (nis),

    CONSTRAINT chk_sexo CHECK (sexo IN ('M', 'F', 'O')),
    CONSTRAINT chk_cpf_format CHECK (cpf ~ '^[0-9]{11}$'),
    CONSTRAINT chk_nis_format CHECK (nis ~ '^[0-9]{11}$'),
    CONSTRAINT chk_telefone_format CHECK (telefone IS NULL OR telefone ~ '^[0-9]+$')
);


CREATE TABLE atividade (
    id_atividade SERIAL,
    descricao VARCHAR(255) NOT NULL,
    id_categoria INTEGER NOT NULL,
    id_funcionario INTEGER NOT NULL,

    CONSTRAINT pk_atividade PRIMARY KEY (id_atividade),

    CONSTRAINT fk_atividade_categoria
        FOREIGN KEY (id_categoria)
        REFERENCES categoria(id_categoria),

    CONSTRAINT fk_atividade_funcionario
        FOREIGN KEY (id_funcionario)
        REFERENCES funcionario(id_funcionario)
);

CREATE TABLE agendamento_atividade (
    id_agendamento SERIAL PRIMARY KEY,

    id_atividade INTEGER NOT NULL,

    data_inicio TIMESTAMP NOT NULL,
    data_fim TIMESTAMP NOT NULL,

    observacao TEXT,

    CONSTRAINT fk_agendamento_atividade
        FOREIGN KEY (id_atividade) REFERENCES atividade(id_atividade)
);

CREATE TABLE IF NOT EXISTS alimento (
    id SERIAL,
    nome varchar(50),
    tipo varchar(50),
    descricao varchar(200),
    CONSTRAINT PK_ALIMENTO PRIMARY KEY (id)
);


CREATE TABLE IF NOT EXISTS tipo_estoque (
    id SERIAL,
    tipo varchar(50) NOT NULL,
    CONSTRAINT PK_TIPOESTOQUE PRIMARY KEY (id),
    CONSTRAINT UN_TIPO_TIPOESTOQUE UNIQUE (tipo)
);


CREATE TABLE IF NOT EXISTS estoque (
    id SERIAL,
    descricao varchar(200),
    qtd int,
    id_tipo_estoque int,
    CONSTRAINT PK_ESTOQUE PRIMARY KEY (id),
    CONSTRAINT FK_ESTOQUE_TIPO_ESTOQUE FOREIGN KEY (id_tipo_estoque) REFERENCES TIPO_ESTOQUE(id)
);



CREATE TABLE cardapio (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(255) NOT NULL,
    data DATE NOT NULL,
    hora TIME NOT NULL,
    id_agendamento INTEGER,

    CONSTRAINT fk_cardapio_agendamento
        FOREIGN KEY (id_agendamento)
        REFERENCES agendamento_atividade(id_agendamento)
        ON DELETE SET NULL
);  

CREATE TABLE itens_cardapio (
    id_cardapio INTEGER NOT NULL,
    id_alimento INTEGER NOT NULL,
    quantidade INTEGER NOT NULL,

    PRIMARY KEY (id_cardapio, id_alimento),

    CONSTRAINT fk_itens_cardapio_cardapio
        FOREIGN KEY (id_cardapio)
        REFERENCES cardapio(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_itens_cardapio_alimento
        FOREIGN KEY (id_alimento)
        REFERENCES alimento(id)
        ON DELETE CASCADE
);

